# CONFIG_LIGHTGW_VARIANT_CORE is not set
# CONFIG_LIGHTGW_VARIANT_CORE_SENSOR is not set
# CONFIG_LIGHTGW_VARIANT_CORE_CLOUD is not set
CONFIG_LIGHTGW_VARIANT_FULL=y
CONFIG_ESP_RMAKER_SELF_CLAIM=y
# CONFIG_ESP_RMAKER_ASSISTED_CLAIM is not set
# CONFIG_ESP_RMAKER_NO_CLAIM is not set
CONFIG_ESP_RMAKER_DISABLE_USER_MAPPING_PROV=y
# CONFIG_ESP_RMAKER_ENABLE_CHALLENGE_RESPONSE is not set
CONFIG_ESP_RMAKER_NETWORK_OVER_WIFI=y
CONFIG_ESP_RMAKER_USE_NVS=y
CONFIG_ESP_RMAKER_USE_CERT_BUNDLE=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
